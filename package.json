{
  "name": "@bagdock/pii-patterns",
  "version": "0.1.0",
  "description": "PII regex patterns and scrubbing utilities for Bagdock",
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "test": "bun test",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bagdock/bagdock-pii-patterns.git"
  },
  "homepage": "https://bagdock.com/docs/pii-patterns",
  "bugs": {
    "url": "https://github.com/bagdock/bagdock-pii-patterns/issues"
  },
  "keywords": [
    "pii",
    "privacy",
    "redaction",
    "scrubbing",
    "gdpr",
    "bagdock"
  ]
}
